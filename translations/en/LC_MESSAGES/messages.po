msgstr "⚠️ [Escort]: Teacher '{t1}' and Teacher '{t2}' have no shared days."

#: app/resit_solver.py:65
#, python-brace-format
msgid "⚠️ [الانفصال]: الأستاذ '{t1}' والأستاذ '{t2}' اشتركا في يوم ({shared})."
msgstr "⚠️ [Separation]: Teacher '{t1}' and Teacher '{t2}' share a day ({shared})."

#: app/resit_solver.py:70
#, python-brace-format
msgid ""
"⚠️ [الحصة الأولى]: الأستاذ '{t}' تمت برمجته في الحصة الأولى من يوم "
"({days_str})."
msgstr "⚠️ [First Period]: Teacher '{t}' is scheduled in the first period on ({days_str})."

